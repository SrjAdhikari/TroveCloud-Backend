{
	"name": "trove-backend",
	"version": "1.0.0",
	"description": "Backend REST API for TroveCloud — a secure cloud file storage and management platform",
	"main": "server.js",
	"type": "module",
	"engines": {
		"node": ">=20.11.0"
	},
	"scripts": {
		"dev": "node --watch server.js",
		"start": "node server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"seed:superadmin": "node scripts/seed-superadmin.js",
		"reconcile:orphans": "node scripts/reconcile-orphans.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SrjAdhikari/trove-backend.git"
	},
	"keywords": [
		"cloud-storage",
		"file-management",
		"rest-api",
		"node.js",
		"express",
		"mongodb"
	],
	"author": "surajadhikari055@gmail.com",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/SrjAdhikari/trove-backend/issues"
	},
	"homepage": "https://github.com/SrjAdhikari/trove-backend#readme",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1125.0",
		"@aws-sdk/lib-storage": "^3.1125.0",
		"@aws-sdk/s3-request-presigner": "^3.1125.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dompurify": "^3.4.8",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.2",
		"google-auth-library": "^10.6.2",
		"helmet": "^8.2.0",
		"jsdom": "^29.1.1",
		"mongoose": "^9.2.4",
		"resend": "^6.9.4",
		"ua-parser-js": "^2.0.9",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"mongodb-memory-server": "^11.1.0",
		"vitest": "^4.1.6"
	}
