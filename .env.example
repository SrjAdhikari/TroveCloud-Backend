# Server
PORT=5001
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Sessions & cookies
COOKIE_SECRET=your-cookie-signing-secret
MAX_ALLOWED_DEVICES=maximum-allowed-devices-per-user

# Email
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=no-reply@example.com

# Cloudflare R2 Credentials (S3-compatible object storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name

# Uploads
MAX_FILE_UPLOAD_SIZE=maximum-bytes-per-uploaded-file
MAX_DRIVE_IMPORT_SIZE=maximum-total-bytes-per-drive-import
MAX_PROFILE_PICTURE_SIZE=maximum-bytes-per-profile-picture

# Storage
DEFAULT_STORAGE_LIMIT=default-storage-quota-in-bytes-per-user
